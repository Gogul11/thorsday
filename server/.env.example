# LLM Configurations
GROQ_API_KEY=your_groq_api_key_here
QWEN=qwen-local:latest
LLAMA=llama3.2:3b

# Default sender email (used by Email Agent until full user authentication is active)
DEFAULT_SENDER_EMAIL=user@agentos.local

# Optional SMTP configuration for live email delivery (leave empty for simulated mode)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

