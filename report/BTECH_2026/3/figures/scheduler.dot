digraph G { rankdir=LR; graph [bgcolor="white", nodesep=.35]; node [shape=box, style="rounded,filled", fillcolor="#eefaf0", color="#31733f", fontname="Helvetica", fontsize=11]; Ready [label="Ready queue\nRedis sorted set"]; Aging [label="Effective priority\nbase + aging"]; Resource [label="Resource manager\nslots + token budget"]; Dispatch [label="Dispatcher\ncooperative quantum"]; Result [label="Result\ncomplete / wait / fail"]; Ready -> Aging -> Resource -> Dispatch -> Result; Result -> Ready [label="requeue if waiting"]; }
