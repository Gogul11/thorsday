digraph G { rankdir=LR; graph [bgcolor="white", nodesep=.4]; node [shape=box, style="rounded,filled", fillcolor="#fff8e8", color="#a56b00", fontname="Helvetica", fontsize=11]; Active [label="Active context\nrecent messages"]; Decide [label="Context pager\nwindow + relevance"]; Swap [label="ChromaDB swap\nembeddings + metadata"]; Retrieve [label="Semantic page-in\nmatching messages"]; Active -> Decide [label="capacity"]; Decide -> Swap [label="page-out"]; Swap -> Retrieve [label="query"]; Retrieve -> Active [label="inject relevant pages"]; }
